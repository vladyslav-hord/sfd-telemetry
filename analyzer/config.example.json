{
  "telemetry_database": "data/sfd_telemetry.sqlite3",
  "analytics_database": "data/sfd_analytics.sqlite3",
  "report_directory": "data/analysis",
  "timezone": "Europe/Warsaw",
  "reconciliation_days": 3,
  "human_player_reports": true,
  "individual_bot_reports": false,
  "openai_enabled": true,
  "openai_model": "gpt-5-nano-2025-08-07",
  "openai_mode": "batch",
  "openai_reasoning_effort": "minimal",
  "send_public_names": true,
  "send_persistent_identifiers": false,
  "max_batch_input_tokens_per_day": 500000,
  "max_batch_output_tokens_per_day": 100000,
  "max_llm_anomaly_windows_per_day": 50,
  "max_chat_messages_per_request": 30,
  "max_input_chars_per_request": 30000,
  "pattern_audit_rate": 0.05,
  "pattern_confirmation_occurrences": 12,
  "pattern_confirmation_players": 3,
  "pattern_confirmation_rounds": 3,
  "anomaly_min_sample_coverage": 0.7,
  "anomaly_robust_z_threshold": 4.0,
  "heatmap_cell_size": 50,
  "static_speed_threshold": 1.0,
  "chat_annotation_retention_days": 30
}
